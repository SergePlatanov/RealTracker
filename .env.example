APP_NAME=RealTracker
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=realtracker
DB_USERNAME=realtracker
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

BLOCKED_MIN_VERSIONS="{\"Microsoft Edge\":\"9999.0\",\"Opera\":\"9999.0\",\"Chrome\":\"9999.0\",\"Firefox\":\"9999.0\",\"Safari\":\"9999.0\",\"Edge\":\"9999.0\",\"Internet Explorer\":\"9999.0\"}"
BROWSER_REFERENCE="Пожалуйста, установите Yandex Browser"

# --- Docker compose (используется docker-compose.yml, Laravel их не читает) ---
# Порт nginx на хосте
NGINX_PORT=80
# Порт MySQL, пробрасываемый на 127.0.0.1 хоста
DB_FORWARD_PORT=3306
# Порт Vite dev-сервера (profile dev)
VITE_PORT=5173
# XDEBUG_MODE=off|debug|develop|trace|profile|coverage (debug требует IDE на порту 9003)
XDEBUG_MODE=off
# UID/GID хостового пользователя для сборки образов (id -u / id -g)
HOST_UID=1000
HOST_GID=1000
